{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metor device schema v1, currently registered simulator subset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "display", "input"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "display": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter", "width_px", "height_px"],
      "properties": {
        "adapter": {"const": "simulator"},
        "width_px": {"type": "integer", "minimum": 1, "maximum": 16384},
        "height_px": {"type": "integer", "minimum": 1, "maximum": 16384},
        "rotation_deg": {"enum": [0, 90, 180, 270], "default": 0},
        "scale": {"type": "number", "minimum": 0.25, "maximum": 8, "default": 1}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter", "ptt_binding", "power_binding"],
      "properties": {
        "adapter": {"const": "simulator"},
        "ptt_binding": {"const": "ptt"},
        "power_binding": {"const": "power"},
        "touch": {"type": "boolean", "default": false}
      }
    },
    "audio": {"$ref": "#/$defs/unavailable"},
    "camera": {"$ref": "#/$defs/unavailable"},
    "indicator": {"$ref": "#/$defs/unavailable"},
    "haptics": {"$ref": "#/$defs/unavailable"},
    "power": {"$ref": "#/$defs/unavailable"},
    "clipboard": {
      "type": "object", "additionalProperties": false,
      "required": ["policy"], "properties": {"policy": {"const": "disabled"}}
    },
    "drivers": {"type": "object", "additionalProperties": false}
  },
  "$defs": {
    "unavailable": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter"], "properties": {"adapter": {"const": "none"}}
    }
  }
}
